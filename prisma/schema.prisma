generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AnalyticsEvent {
  id        String             @id @default(cuid())
  type      AnalyticsEventType
  storeId   String
  productId String?
  sessionId String
  origin    String?
  createdAt DateTime           @default(now())
  product   Product?           @relation(fields: [productId], references: [id])
  store     Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, type, createdAt])
  @@index([productId, type, createdAt])
  @@index([sessionId, type, storeId, createdAt])
  @@map("analytics_events")
}

model User {
  id                String               @id @default(cuid())
  name              String
  email             String               @unique
  passwordHash      String?
  role              UserRole             @default(VISITANTE)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  auditLogsMade     AuditLog[]
  favoriteProducts  ProductFavorite[]
  reviews           Review[]
  favoriteStores    StoreFavorite[]
  storeMemberships  StoreMember[]
  statusChangesMade StoreStatusHistory[] @relation("StatusChangedBy")

  @@map("users")
}

model Store {
  id              String               @id @default(cuid())
  name            String
  slug            String               @unique
  description     String
  location        String
  latitude        Float?
  longitude       Float?
  cnpj            String
  phone           String?
  whatsapp        String?
  email           String?
  instagram       String?
  gallery         String?
  logoUrl String?
  logoInitials    String
  coverTone       String               @default("pine")
  status          StoreStatus          @default(PENDING)
  isVerified      Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  mercadoLivreUrl String?
  shopeeUrl       String?
  tiktokShopUrl   String?
  openingHours    String?
  zone            StoreZone?
  analyticsEvents AnalyticsEvent[]
  products        Product[]
  galleryImages StoreGalleryImage[]
  reviews         Review[]
  categories      StoreCategory[]
  favoritedBy     StoreFavorite[]
  members         StoreMember[]
  statusHistory   StoreStatusHistory[]

  @@index([status])
  @@map("stores")
}

model StoreMember {
  id        String          @id @default(cuid())
  storeId   String
  userId    String
  role      StoreMemberRole @default(OWNER)
  createdAt DateTime        @default(now())
  store     Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@map("store_members")
}

model Category {
  id        String          @id @default(cuid())
  name      String          @unique
  slug      String          @unique
  createdAt DateTime        @default(now())
  products  Product[]
  stores    StoreCategory[]

  @@map("categories")
}

model StoreCategory {
  storeId    String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, categoryId])
  @@map("store_categories")
}

model Product {
  id              String            @id @default(cuid())
  storeId         String
  categoryId      String
  name            String
  description     String?
  price           Int?
  status          ProductStatus     @default(ACTIVE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  externalUrl     String?
  analyticsEvents AnalyticsEvent[]
  favoritedBy     ProductFavorite[]
  images          ProductImage[]
  category        Category          @relation(fields: [categoryId], references: [id])
  store           Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([categoryId])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  altText   String?
  position  Int      @default(0)
  isCover   Boolean  @default(false)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model StoreStatusHistory {
  id              String       @id @default(cuid())
  storeId         String
  fromStatus      StoreStatus?
  toStatus        StoreStatus
  changedByUserId String?
  reason          String?
  createdAt       DateTime     @default(now())
  changedBy       User?        @relation("StatusChangedBy", fields: [changedByUserId], references: [id])
  store           Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("store_status_history")
}

model AuditLog {
  id         String      @id @default(cuid())
  entityType String
  entityId   String
  action     AuditAction
  userId     String?
  diff       Json?
  createdAt  DateTime    @default(now())
  user       User?       @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Review {
  id        String   @id @default(cuid())
  storeId   String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@map("reviews")
}

model StoreFavorite {
  userId    String
  storeId   String
  createdAt DateTime @default(now())
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
  @@map("store_favorites")
}

model ProductFavorite {
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@map("product_favorites")
}

enum UserRole {
  ADMIN
  LOJISTA
  VISITANTE
}

enum StoreZone {
    GALERIA
    AV_ITAGUACU
    PORTO_ITAGUACU
    SHOPPING
    LADEIRA
    RADIO_TV
    AV_JULIO_PRESTES
}

enum AnalyticsEventType {
  STORE_VIEW
  PRODUCT_VIEW
  WHATSAPP_CLICK
  ADD_TO_LIST
  LIST_WHATSAPP_SENT
}

enum StoreStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum StoreMemberRole {
  OWNER
  EDITOR
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
}

model StoreGalleryImage {
  id        String   @id @default(cuid())
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId   String
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([storeId])
  @@map("store_gallery_images")
}